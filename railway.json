{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20", "openssl"]
        },
        "install": {
          "commands": ["cd api && npm install --legacy-peer-deps"]
        },
        "build": {
          "commands": ["cd api && npm run build || true"]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "startCommand": "cd api && npm start",
    "healthchecks": {
      "readiness": {
        "path": "/health",
        "initialDelaySeconds": 10,
        "periodSeconds": 10
      }
    }
  }
}
